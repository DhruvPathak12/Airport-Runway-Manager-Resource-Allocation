# =====================================================
# Smart Air Traffic Control Management System
# .gitignore
# =====================================================

# --- Database credentials — NEVER commit this file ---
db.conf
cradential.txt
*credential*.txt

# --- CMake build output ---
build/
cmake-build-debug/
cmake-build-release/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake
install_manifest.txt
CTestTestfile.cmake

# --- Compiled binaries and object files ---
*.o
*.a
*.so
*.dll
*.exe
*.out
*.app

# --- Qt MOC / UIC / RCC auto-generated files ---
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.moc

# --- Qt Creator project files ---
*.pro.user
*.pro.user.*
*.creator
*.creator.user
*.config
*.files
*.includes
*.user
*.user.*
CMakeLists.txt.user

# --- IDE and editor ---
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
*.rej

# --- OS-generated ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
