flowchart TD
    StartTx([Call: ApplicationService::allocateRunway]) --> QSqlBegin[Begin Transaction: db.transaction]
    
    QSqlBegin --> Step0[Pessimistic Locking & Validation:<br/>SELECT FOR UPDATE on runways, runway_assignments, flights, scheduling_queue]
    Step0 --> Step0Check{Runway Available & Flight Eligible?}
    Step0Check -- No / Conflict / Lock Timeout --> DoRollback

    Step0Check -- Yes --> Step1[1. INSERT INTO runway_assignments<br/>status = 'Active']
    Step1 --> Step1Check{Assignment Inserted?}
    Step1Check -- Failure --> DoRollback

    Step1Check -- Yes --> Step2[2. UPDATE runways<br/>SET status = 'Occupied']
    Step2 --> Step2Check{Runway Status Updated?}
    Step2Check -- Failure --> DoRollback

    Step2Check -- Yes --> Step3[3. UPDATE flights<br/>SET operational_status = 'Cleared'<br/>if Scheduled or Taxiing]
    Step3 --> Step3Check{Flight Status Updated?}
    Step3Check -- Failure --> DoRollback

    Step3Check -- Yes --> Step4[4. INSERT INTO operation_logs<br/>transaction_status = 'Committed'<br/>Inside Transaction Boundary]
    Step4 --> Step4Check{Audit Log Inserted?}
    Step4Check -- Failure --> DoRollback

    Step4Check -- Yes --> QSqlCommit[Execute: db.commit]
    QSqlCommit --> CommitCheck{Commit Succeeded?}
    CommitCheck -- Failure --> DoRollback

    CommitCheck -- Yes --> MemConfirm[ResourceManager: confirmAllocationUnlocked<br/>Mark In-Memory Runway Occupied]
    MemConfirm --> Success([Success: Allocation Committed])

    DoRollback[Execute: db.rollback] --> MemRollback[ResourceManager: rollbackAllocationUnlocked<br/>Revert In-Memory Runway to Available]
    MemRollback --> Failure([Transaction Rolled Back: All DB Changes Discarded])
