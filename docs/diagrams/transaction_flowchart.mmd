flowchart TD
    StartTx([Begin Transaction: allocateRunwayWithTransaction]) --> QSqlBegin[QSqlDatabase::transaction()]
    
    QSqlBegin --> Step0[Pessimistic Locking:<br/>SELECT status FROM runways WHERE id=? FOR UPDATE]
    Step0 --> Step0Check{Query Succeeded & Status == FREE?}
    Step0Check -- Failure / Already Locked --> DoRollback

    Step0Check -- Success --> Step1[Step 1: UPDATE flights<br/>SET status = 'LANDED'/'DEPARTED'<br/>WHERE id = ?]
    Step1 --> Step1Check{Step 1 Succeeded & Rows Affected == 1?}
    Step1Check -- Failure / Row Missing --> DoRollback

    Step1Check -- Success --> Step2[Step 2: INSERT INTO runway_assignments<br/>(flight_id, runway_id, assigned_at, status)<br/>VALUES (?, ?, NOW(), 'ACTIVE')]
    Step2 --> Step2Check{Step 2 Succeeded?}
    Step2Check -- Failure / FK Violation --> DoRollback

    Step2Check -- Success --> Step3[Step 3: UPDATE runways<br/>SET status = 'OCCUPIED', current_flight_id = ?<br/>WHERE id = ?]
    Step3 --> Step3Check{Step 3 Succeeded & Rows Affected == 1?}
    Step3Check -- Failure / Constraint Check --> DoRollback

    Step3Check -- Success --> Step4[Step 4: UPDATE scheduling_queue<br/>SET state = 'COMPLETED', updated_at = NOW()<br/>WHERE flight_id = ?]
    Step4 --> Step4Check{Step 4 Succeeded?}
    Step4Check -- Failure --> DoRollback

    Step4Check -- Success --> QSqlCommit[QSqlDatabase::commit()]
    QSqlCommit --> CommitCheck{Commit Succeeded?}
    CommitCheck -- Failure --> DoRollback

    CommitCheck -- Success --> AuditSuccess[Log SUCCESS to operation_logs]
    AuditSuccess --> Success([Transaction Completed Successfully])

    DoRollback[Execute QSqlDatabase::rollback()] --> AuditFail[Log FAILURE to operation_logs]
    AuditFail --> RevertMem[Revert In-Memory Runway & Process State]
    RevertMem --> Failure([Transaction Aborted: Complete Rollback Guaranteed])
