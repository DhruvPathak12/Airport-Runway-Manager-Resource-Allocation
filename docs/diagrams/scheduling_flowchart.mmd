flowchart TD
    Start([Process Arrival / Scheduling Cycle]) --> EvalEmergency{Is In-Flight Emergency Declared?}
    
    EvalEmergency -- Yes --> SetPriority1[Set Effective Priority = 1<br/>Emergency Highest Priority]
    SetPriority1 --> PushQueue[Enqueue Process in ReadyQueue]

    EvalEmergency -- No --> CheckAging{Is Priority Aging Evaluated?}
    CheckAging -- Yes --> CalcWait[Compute continuous READY wait time: now - readySince]
    CalcWait --> CheckIntervals{Completed Aging Intervals > 0?}
    CheckIntervals -- Yes --> DecrementPriority[Improve Priority: effectivePriority = max 1, basePriority - agingLevel]
    CheckIntervals -- No --> UseBasePriority[effectivePriority = basePriority]
    CheckAging -- No --> UseBasePriority
    
    DecrementPriority --> PushQueue
    UseBasePriority --> PushQueue

    PushQueue --> ScanQueue[Evaluate Candidate Process by Deterministic Order:<br/>1. Effective Priority ASC Lowest Number = Highest Priority<br/>2. Arrival Time ASC FCFS<br/>3. Flight ID ASC Stable PID]

    ScanQueue --> CheckRunning{Is a Process Already RUNNING?}
    CheckRunning -- Yes --> BusyWait([Non-Preemptive: Running Process Retains Runway])

    CheckRunning -- No --> PopHead[Select Candidate Process from ReadyQueue]
    PopHead --> CheckRunway{Compatible Available Runway Found?}

    CheckRunway -- No --> RetainQueue([No Runway Available: Candidate Remains in READY])

    CheckRunway -- Yes --> OccupyRunway[Transition Process to RUNNING<br/>Allocate Runway Resource Exclusively]
    OccupyRunway --> ServiceDuration[Hold Runway Non-Preemptively for serviceTime]
    ServiceDuration --> CompleteProc[Release Runway Resource<br/>Transition to COMPLETED & Record CT, TAT, WT Metrics]
    CompleteProc --> Done([Process Completed])
