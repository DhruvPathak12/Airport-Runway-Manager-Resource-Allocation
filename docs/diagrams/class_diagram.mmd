classDiagram
    class Process {
        +int id
        +int flightId
        +QDateTime arrivalTime
        +int basePriority
        +int effectivePriority
        +QDateTime readySince
        +int agingLevel
        +bool isEmergency
        +int serviceTime
        +ProcessState state
        +int waitingTime
        +int turnaroundTime
        +QDateTime completionTime
        +setEmergency(bool) void
        +calculateAgingLevels(QDateTime, int) int
        +calculateEffectivePriority(QDateTime, int) int
    }

    class ReadyQueue {
        -QList~Process~ m_queue
        -mutable QMutex m_mutex
        +enqueue(Process, QString*) bool
        +dequeue(Process*, QString*) bool
        +peek(Process*) bool
        +size() int
        +isEmpty() bool
        +allProcesses() QList~Process~
    }

    class Scheduler {
        -ReadyQueue m_readyQueue
        -AgingEngine m_agingEngine
        -bool m_hasRunningProcess
        -Process m_runningProcess
        +selectNextProcess(Process*, QString*) bool
        +dispatchNextProcess() DispatchResult
        +evaluateAging(QDateTime, int*) int
        +runScheduler() void
        +performanceMetrics() PerformanceMetrics
    }

    class AgingEngine {
        -QTimer* m_timer
        -int m_intervalSeconds
        -bool m_isRunning
        +evaluateAging(ReadyQueue&, QDateTime, int*) int
        +setIntervalSeconds(int, QString*) bool
        +start(QString*) bool
        +stop() void
        +isRunning() bool
    }

    class ResourceManager {
        -QMap~int, Runway~ m_runways
        -mutable std::mutex m_resourceMutex
        +isRunwayAvailable(int) bool
        +requestAllocation(int, int) bool
        +confirmAllocationUnlocked(int, int) void
        +rollbackAllocationUnlocked(int, int) void
        +releaseRunway(int) bool
    }

    class DatabaseManager {
        -QString m_host
        -int m_port
        -QString m_databaseName
        -bool m_connected
        +instance() DatabaseManager*
        +connectToDatabase(QString*) bool
        +disconnectFromDatabase() void
        +isConnected() bool
        +database() QSqlDatabase
    }

    class ApplicationService {
        -Scheduler* m_scheduler
        -ResourceManager* m_resourceManager
        -Session m_session
        +allocateRunway(int, int, QString*) AllocationResult
        +releaseRunway(int, QString*) bool
        +declareFlightEmergency(int, bool, QString*) bool
        +scheduleAndAllocateNext(QString*) ScheduleAndAllocateResult
        +getDashboardMetrics(QString*) DashboardMetrics
    }

    class Flight {
        +int id
        +QString flightNumber
        +QString airline
        +int aircraftId
        +FlightType flightType
        +int priority
        +bool isEmergency
        +OperationalStatus status
    }

    class Runway {
        +int id
        +QString runwayNumber
        +RunwayType runwayType
        +RunwayStatus status
        +int currentFlightId
    }

    class Session {
        -int m_userId
        -QString m_username
        -QString m_role
        +hasPermission(QString) bool
        +isAdmin() bool
        +isATC() bool
        +isOperator() bool
    }

    ApplicationService o-- Scheduler
    ApplicationService o-- ResourceManager
    ApplicationService o-- Session
    ApplicationService ..> DatabaseManager : queries
    Scheduler o-- ReadyQueue
    Scheduler o-- AgingEngine
    ReadyQueue o-- Process
    ResourceManager o-- Runway
    Process ..> Flight : references PID
