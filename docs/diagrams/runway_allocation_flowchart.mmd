flowchart TD
    Req([Runway Allocation Request: Flight F, Runway R]) --> CheckAuth{Session Authorized for RunwayAllocation?}
    CheckAuth -- No --> RejectAuth([Return: Unauthorized])
    CheckAuth -- Yes --> LockRes[Acquire ResourceManager ScopedResourceLock std::mutex]

    LockRes --> CheckMemStatus{Is Runway Available in Memory?}
    CheckMemStatus -- No --> UnlockReject([Release Mutex: Return Conflict])

    CheckMemStatus -- Yes --> StartTx[Start Database Transaction: db.transaction]
    StartTx --> LockRw[SELECT runway_number, runway_type, status FROM runways WHERE runway_id = ? FOR UPDATE]
    LockRw --> CheckRwAvail{Runway Exists & Status == 'Available'?}
    CheckRwAvail -- No --> AbortTx[Rollback Transaction]

    CheckRwAvail -- Yes --> LockRwAssign[SELECT assignment_id FROM runway_assignments WHERE runway_id = ? AND status = 'Active' FOR UPDATE]
    LockRwAssign --> CheckActiveRw{Any Active Assignment on Runway?}
    CheckActiveRw -- Yes --> AbortTx

    CheckActiveRw -- No --> LockFlight[SELECT flight_number, flight_type, operational_status FROM flights WHERE flight_id = ? FOR UPDATE]
    LockFlight --> CheckFlightElig{Flight Not Terminal & Type Compatible with Runway?}
    CheckFlightElig -- No --> AbortTx

    CheckFlightElig -- Yes --> LockFltAssign[SELECT assignment_id FROM runway_assignments WHERE flight_id = ? AND status = 'Active' FOR UPDATE]
    LockFltAssign --> CheckActiveFlt{Flight Already Has Active Assignment?}
    CheckActiveFlt -- Yes --> AbortTx

    CheckActiveFlt -- No --> CheckQueue[SELECT process_state FROM scheduling_queue WHERE flight_id = ? FOR UPDATE]
    CheckQueue --> CheckProcState{Process Not Completed?}
    CheckProcState -- No --> AbortTx

    CheckProcState -- Yes --> Step1[1. INSERT INTO runway_assignments status='Active']
    Step1 --> Step2[2. UPDATE runways SET status='Occupied']
    Step2 --> Step3[3. UPDATE flights SET operational_status='Cleared']
    Step3 --> Step4[4. INSERT INTO operation_logs transaction_status='Committed']

    Step4 --> CheckSql{All Mutations Succeeded?}
    CheckSql -- No --> AbortTx

    CheckSql -- Yes --> CommitTx[COMMIT Transaction: db.commit]
    CommitTx --> CheckCommit{Commit Succeeded?}
    CheckCommit -- No --> AbortTx

    CheckCommit -- Yes --> MemConfirm[ResourceManager: confirmAllocationUnlocked<br/>Update In-Memory Status to Occupied]
    MemConfirm --> ReleaseMutexSuccess[Release std::mutex ScopedResourceLock]
    ReleaseMutexSuccess --> Success([Return: Allocation Succeeded])

    AbortTx --> MemRollback[ResourceManager: rollbackAllocationUnlocked<br/>Revert In-Memory Status to Available]
    MemRollback --> ReleaseMutexFail[Release std::mutex ScopedResourceLock]
    ReleaseMutexFail --> Fail([Return: Allocation Failed])
